# Database. Use a Postgres URL (for example Supabase) in production.
# For local development an embedded Postgres (PGlite) is used with: pglite://./data/pgdata
DATABASE_URL=pglite://./data/pgdata
# Protects GET /api/cron/daily (send as "Authorization: Bearer <value>")
CRON_SECRET=
# Sentinel-2 vegetation statistics (Copernicus Data Space, free account)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# CEDA Agri Market Data API key (free, https://api.ceda.ashoka.edu.in/). Or import CSVs into data/raw/ceda/
CEDA_API_KEY=
# Optional live mandi reading (free key from https://data.gov.in)
DATA_GOV_IN_API_KEY=
# Optional: Solara AI wording via Gemini (free tier key from https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: Telegram alerts (token from @BotFather)
TELEGRAM_BOT_TOKEN=
OPEN_METEO_BASE_URL=https://api.open-meteo.com
NEXT_PUBLIC_APP_NAME=Solara Field Advisor
